# Database (Neon PostgreSQL recommended)
DATABASE_URL="postgresql://user:password@host:5432/bch_local?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-secret-here"

# Demo Payment Mode - set to "true" to enable demo payments (never mix with real)
DEMO_PAYMENT_MODE="true"

# BCH Infrastructure (production verification)
# Wire a real indexer/API before claiming on-chain confirmation
BCH_RPC_URL=""
BCH_INDEXER_URL=""
BCH_API_KEY=""

# Exchange rate source (for MZN <-> BCH)
BCH_RATE_API_URL="https://api.coingecko.com/api/v3/simple/price?ids=bitcoin-cash&vs_currencies=usd"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEFAULT_LOCALE="pt"
NEXT_PUBLIC_DEFAULT_COUNTRY="MZ"
NEXT_PUBLIC_DEFAULT_CITY="Maputo"

# Image storage (local public/uploads by default)
UPLOAD_DIR="./public/uploads"
# Optional Cloudinary — recommended on Vercel (local disk is ephemeral)
# CLOUDINARY_CLOUD_NAME=""
# CLOUDINARY_UPLOAD_PRESET=""
# DEBUG_LISTINGS="true"

# Platform revenue address (promotions / business fees — not user trade payments)
PLATFORM_BCH_ADDRESS=""
